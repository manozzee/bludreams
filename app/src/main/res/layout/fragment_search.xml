<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/navbar_height"
    android:background="?attr/primaryBlackBackground"
    tools:context=".ui.search.SearchFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- Prominent Search Heading at top-left -->
            <TextView
                android:id="@+id/search_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:textAppearance="@style/TextAppearance.CloudStream.Headline"
                android:text="@string/search"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <!-- Modern unified Compose search header (exact Settings & Library pill UI + circular buttons) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/search_header_compose_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <!-- Category selection chips below action icons -->
            <include
                android:id="@+id/tvtypes_chips_scroll"
                layout="@layout/tvtypes_chips_scroll" />
        </LinearLayout>

        <com.lagradost.cloudstream3.ui.AutofitRecyclerView
            android:id="@+id/search_autofit_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:nextFocusLeft="@id/nav_rail_view"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="120dp"
            android:visibility="gone"
            app:spanCount="3"
            tools:listitem="@layout/search_result_grid" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_master_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            android:descendantFocusability="afterDescendants"
            android:nextFocusLeft="@id/nav_rail_view"
            android:nextFocusUp="@id/tvtypes_chips"
            android:visibility="gone"
            tools:listitem="@layout/homepage_parent" />

        <!-- Polished Empty State for History -->
        <LinearLayout
            android:id="@+id/search_history_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circular_action_button_bg"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/history_toggle_off_24px"
                    tools:ignore="ContentDescription"
                    app:tint="?attr/textColor" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_search_history"
                android:textAppearance="@style/TextAppearance.CloudStream.Title"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/no_search_history_sub"
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_history_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="120dp"
            android:descendantFocusability="afterDescendants"
            android:nextFocusLeft="@id/nav_rail_view"
            android:nextFocusUp="@id/tvtypes_chips"
            android:visibility="visible"
            tools:listitem="@layout/search_history_item" />

        <!-- Suggestions list in the content area below header -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_suggestions_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="120dp"
            android:descendantFocusability="afterDescendants"
            android:nextFocusLeft="@id/nav_rail_view"
            android:nextFocusUp="@id/tvtypes_chips"
            android:visibility="gone"
            tools:listitem="@layout/search_suggestion_item" />
    </LinearLayout>

    <!-- Legacy view references preserved for ViewBinding compatibility -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="UselessParent">

        <FrameLayout
            android:id="@+id/search_field_container"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/main_search"
                android:layout_width="0dp"
                android:layout_height="0dp">

                <androidx.core.widget.ContentLoadingProgressBar
                    android:id="@+id/search_loading_bar"
                    style="@style/Widget.AppCompat.ProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </androidx.appcompat.widget.SearchView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/voice_search_container"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <ImageView
                android:id="@+id/voice_search"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/search_filter_container"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <ImageView
                android:id="@+id/search_filter"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
